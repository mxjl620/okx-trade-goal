{
  "manifest_version": 3,
  "name": "交易目标 · OKX 实时进度",
  "version": "2.2.14",
  "minimum_chrome_version": "130",
  "description": "在 OKX 永续交易页跟踪资金目标，查看实时进度、复利计划与逐笔平仓回撤。",
  "permissions": ["storage"],
  "background": { "service_worker": "src/private-storage.js" },
  "action": {
    "default_title": "展开 OKX 交易目标",
    "default_popup": "live-popup.html",
    "default_icon": { "16": "icons/16.png", "32": "icons/32.png" }
  },
  "content_scripts": [
    {
      "matches": ["https://www.okx.com/*trade-swap/*", "https://okx.com/*trade-swap/*"],
      "js": ["src/goal-input-keys.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.okx.com/*trade-swap/*", "https://okx.com/*trade-swap/*"],
      "js": ["src/capital.js", "src/risk.js", "src/round.js", "src/okx-reader.js", "src/okx-history.js", "src/private-storage.js", "src/overlay-ui.js", "src/live.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" }
}
